# Local overrides first: ssh uses the first value it obtains for each option,
# so an Include at the bottom of the file could never override anything here.
Include ~/.ssh/config.local

# Two GitHub identities, both normally loaded in the agent.
#
# IdentityFile points at a .pub deliberately: that is how ssh selects a
# specific agent-held key when the private key is not on disk, which lets this
# repo ship key selection without shipping any secrets.
#
# IdentitiesOnly is the part that makes the selection actually stick. Without
# it ssh offers every identity in the agent regardless of what is configured
# here, so with both keys loaded GitHub would authenticate as whichever one the
# agent happened to return first.

# Default identity.
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519_main.pub
	IdentitiesOnly yes

# Alternate identity for InfoTrust repositories. Clone through this alias:
#     git clone git@github-infotrust:org/repo.git
# or let bin/git_clone_infotrust rewrite the URL for you.
Host github-infotrust
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519_infotrust_github.pub
	IdentitiesOnly yes
